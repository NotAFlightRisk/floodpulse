{
  "name": "floodpulse",
  "version": "0.1.0",
  "description": "Every river gauge in England on one live map, each read against its own normal",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAFlightRisk/floodpulse.git"
  },
  "homepage": "https://floodpulse.peng.ly",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rivers": "node scripts/rivers/build.ts"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@maplibre/geojson-vt": "^6.3.1",
    "@maplibre/vt-pbf": "^4.3.3",
    "@sentry/browser": "^11.12.0",
    "@sentry/vite-plugin": "^11.12.0",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "maplibre-gl": "^6.18.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tinyqueue": "^3.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
