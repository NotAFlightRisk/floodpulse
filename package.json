{
  "name": "floodpulse",
  "version": "0.1.0",
  "description": "Every river gauge in England on one live map, each read against its own normal",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAFlightRisk/floodpulse.git"
  },
  "homepage": "https://floodpulse.peng.ly",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@sentry/browser": "^11.8.0",
    "@sentry/vite-plugin": "^11.8.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "maplibre-gl": "^6.15.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
